# ==================================================
# CodeBridge Environment Configuration Example
# ==================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control or expose production secrets.

# Server & Network Configuration
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
# Example for production: https://your-site.netlify.app,https://codebridge.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (MongoDB Atlas or local MongoDB)
# For local development with standalone MongoDB: mongodb://127.0.0.1:27017/codebridge
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/codebridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codebridge

# File Storage Configuration
# Options: 'local' (development disk) or 's3' (persistent S3 / Cloudflare R2)
STORAGE_PROVIDER=local
# Local storage directory path
UPLOAD_DIR=uploads

# S3 / Cloudflare R2 Object Storage (Required only if STORAGE_PROVIDER=s3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=codebridge-transfers
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# Transfer Expiry & Transfer Quotas
TRANSFER_EXPIRY_MINUTES=10
MAX_FILE_SIZE_MB=100
MAX_TOTAL_TRANSFER_MB=250
MAX_FILES_PER_TRANSFER=10

# Security & Rate Limiting
# Options: 'memory' (single instance dev/test) or 'redis' (production multi-instance Render)
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://default:<password>@redis-host:6379

# AI Privacy & Intelligence Providers (Optional, consent-based)
# Supported providers: 'mock' (default fallback), 'openai', 'gemini'
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-placeholder-key
# GEMINI_API_KEY=placeholder-gemini-key

# Client App URL (for generating shareable QR join links)
# In production, set to your Netlify URL, e.g. https://your-codebridge.netlify.app
FRONTEND_URL=http://localhost:5173
